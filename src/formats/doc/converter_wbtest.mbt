// White-box tests for the Word binary (.doc/.wps) converter.
// Fixtures are embedded as base64 so the tests stay hermetic (no filesystem
// IO — WSL1 lacks statx, and the converter's `convert_bytes` entry is pure).
// Fixtures were generated by tools/make_doc_fixtures.py and verified against
// the wps2md reference algorithm.

///|
fn doc_bytes(b64 : String) -> Bytes {
  @base64.decode(b64, ignore_whitespace=true) catch {
    _ => Bytes::new(0)
  }
}

///|
test "doc word_english e2e headings lists table" {
  let result = convert_bytes(
    doc_bytes(word_english_b64()),
    "report.doc",
  ) catch {
    err => fail("convert failed: \{err}")
  }
  let md = result.markdown
  assert_true(md.contains("# Quarterly Engineering Report"))
  assert_true(md.contains("## Overview"))
  assert_true(md.contains("### Highlights"))
  assert_true(md.contains("## Metrics"))
  assert_true(md.contains("- First highlight item with details"))
  assert_true(md.contains("- Second highlight item"))
  assert_true(md.contains("| Feature | Status | Owner |"))
  assert_true(md.contains("| Parser engine | Done | Alice |"))
  assert_true(md.contains("| Web upload | In progress | Bob |"))
  assert_true(md.contains("End of report."))
}

///|
test "doc word_english summary information metadata" {
  let result = convert_bytes(
    doc_bytes(word_english_b64()),
    "report.doc",
  ) catch {
    err => fail("convert failed: \{err}")
  }
  assert_eq(result.title, Some("Quarterly Engineering Report"))
  assert_eq(result.metadata.get("format"), Some("doc"))
  assert_eq(result.metadata.get("container"), Some("ole2"))
  assert_eq(result.metadata.get("author"), Some("Alice"))
  assert_eq(result.metadata.get("page_count"), Some("3"))
}

///|
test "doc word95 0xA5DC legacy magic and 0Table" {
  let result = convert_bytes(
    doc_bytes(word95_b64()),
    "legacy.doc",
  ) catch {
    err => fail("convert failed: \{err}")
  }
  assert_true(result.markdown.contains("# Legacy Document"))
  assert_true(result.markdown.contains("Old format text."))
}

///|
test "doc encrypted document rejected" {
  let outcome : Option[@core.ConvertResult] = try {
    Some(convert_bytes(doc_bytes(word_encrypted_b64()), "secret.doc"))
  } catch {
    _ => None
  }
  match outcome {
    Some(result) => fail("expected rejection, got markdown: \{result.markdown}")
    None => ()
  }
}

///|
test "doc corrupt cfb magic rejected" {
  let outcome : Option[@core.ConvertResult] = try {
    Some(convert_bytes(doc_bytes(corrupt_magic_b64()), "bad.doc"))
  } catch {
    _ => None
  }
  match outcome {
    Some(result) => fail("expected error, got markdown: \{result.markdown}")
    None => ()
  }
}

///|
test "doc multipiece utf16 and cp1252 pieces" {
  let result = convert_bytes(
    doc_bytes(word_multipiece_b64()),
    "multi.doc",
  ) catch {
    err => fail("convert failed: \{err}")
  }
  let md = result.markdown
  assert_true(md.contains("# Multi Piece Doc"))
  assert_true(md.contains("The first piece is stored as UTF-16 text."))
  assert_true(md.contains("The second piece is stored as 8-bit compressed text."))
}

///|
test "doc cp1252 high region decodes" {
  // 0xE9 é, 0xA9 ©, 0x80 €, 0x96 –, 0xD0 Ð, 0xFF ÿ
  let text = decode_cp1252(b"\xE9\xA9\x80\x96\xD0\xFF", 0, 6)
  assert_eq(text, "é©€–Ðÿ")
}

///|
test "doc utf16le surrogate pair decodes" {
  // U+1F600 (😀) = D83D DE00 in UTF-16LE
  let text = decode_utf16le(b"\x3D\xD8\x00\xDE", 0, 2)
  assert_eq(text, "😀")
}
