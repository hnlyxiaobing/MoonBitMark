name = "hnlyxiaobing/moonbitmark"

version = "0.4.0"

import {
  "moonbitlang/async@0.21.0",
  "bobzhang/mbtpdf@0.1.2",
}

readme = "README.md"

repository = "https://github.com/hnlyxiaobing/MoonBitMark"

license = "Apache-2.0"

keywords = [ "markdown", "converter", "document", "docx", "word" ]

description = "Convert documents and URLs to Markdown with a MoonBit engine"

preferred_target = "native"
